{
  "$schema": "https://json.schemastore.org/claude-code-plugin-marketplace.json",
  "name": "yuzushi",
  "owner": {
    "name": "yuzushi-dev",
    "url": "https://github.com/yuzushi-dev"
  },
  "metadata": {
    "description": "Plugin di yuzushi-dev per Claude Code e Codex.",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "session-handoff",
      "source": {
        "source": "url",
        "url": "https://github.com/yuzushi-dev/session-handoff.git",
        "ref": "main"
      },
      "description": "Create handoffs and migrate sessions between Claude Code and Codex.",
      "version": "0.7.0",
      "author": { "name": "yuzushi-dev" },
      "license": "MIT",
      "category": "productivity",
      "keywords": ["handoff", "session", "context", "codex", "claude"]
    },
    {
      "name": "sando",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/yuzushi-dev/Sando.git",
        "path": "adapters/claude/sando",
        "ref": "main"
      },
      "description": "Bound repeated tool-output context locally in Claude Code with deterministic hooks, provider accounting, and explicit local routes.",
      "version": "0.4.0",
      "author": { "name": "yuzushi-dev" },
      "license": "MIT",
      "category": "productivity",
      "keywords": ["context", "accounting", "paired-controls", "hooks", "mcp", "claude", "codex"]
    }
  ]
}
